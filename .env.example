# Supabase (en prod estas vars viven en /opt/fiba-nominations/.env del droplet)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Frontend
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_URL=/api

# CORS — comma-separated allowed origins (defaults to localhost for dev)
CORS_ORIGINS=https://www.fibaapp.com,https://fibaapp.com

# CloudConvert (for PDF generation)
CLOUDCONVERT_API_KEY=your_cloudconvert_api_key

# FIBA GDAP (gdap.fiba.basketball) — key de la suscripción "FIBA Americas" en
# https://gdap-portal.fiba.basketball/profile (Primary key). Fuente del sync de
# partidos, resultados y fechas, y de "Nuevas en FIBA" (services/fiba_sync.py).
GDAP_API_KEY=your_gdap_subscription_key

# Feed de la web pública de FIBA (digital-api…/hapi). Solo como respaldo del sync
# de partidos cuando falta GDAP_API_KEY. The previous value was hardcoded in
# source and is compromised — never commit it.
FIBA_API_KEY=your_fiba_subscription_key
